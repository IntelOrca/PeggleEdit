<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CoreJ2K" Version="2.4.1.108" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="IntelOrca.PeggleEdit.Tools.Tests" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Levels\PolyEditor.cs">
      <SubType>Form</SubType>
    </Compile>
    <Compile Update="Levels\PolyEditor.Designer.cs">
      <DependentUpon>PolyEditor.cs</DependentUpon>
    </Compile>
    <Compile Update="Properties\Resources.Designer.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="Levels\PolyEditor.resx">
      <DependentUpon>PolyEditor.cs</DependentUpon>
    </EmbeddedResource>
    <!-- The game's images PeggleEdit draws itself, under the paths the game has them at (see GameFiles) -->
    <EmbeddedResource Include="Resources\GameFiles\**\*" LogicalName="GameFiles\%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>
</Project>
