<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2"/>
  </startup>
  <!-- System DPI aware: the whole UI is scaled once, for the DPI of the primary display, so it renders
       crisply instead of being bitmap-stretched by Windows. See the comment in app.manifest. -->
  <System.Windows.Forms.ApplicationConfigurationSection>
    <add key="DpiAwareness" value="SystemAware" />
  </System.Windows.Forms.ApplicationConfigurationSection>
  <appSettings>
    <!-- Lets Windows Forms scale its own controls for the DPI (e.g. menu and property grid images); system
         awareness alone does not turn that on. -->
    <add key="EnableWindowsFormsHighDpiAutoResizing" value="true" />
  </appSettings>
</configuration>
